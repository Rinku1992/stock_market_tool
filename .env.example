# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Model used for all LLM analysts. Keep it fixed: changing it moves the backtest cutoff date.
SMT_CLAUDE_MODEL=claude-sonnet-5-5
# Optional: a different model for one task only. Name = SMT_CLAUDE_MODEL_ + the task in capitals,
# other characters as _. Example (task "desk_summary:market_activity"):
# SMT_CLAUDE_MODEL_DESK_SUMMARY_MARKET_ACTIVITY=claude-sonnet-5-5
# LLM budget guard (input + output tokens, real API calls only; cache hits are free).
# A call that would pass a cap is stopped with a message showing tokens used so far.
# Most tokens one engine run (one LLM client) may use:
SMT_LLM_MAX_TOKENS_PER_RUN=100000
# Most tokens per day (India time), all runs together, counted from the llm_calls table:
SMT_LLM_MAX_TOKENS_PER_DAY=300000
# 1 = make no API calls; print each call's task, model and estimated tokens instead.
SMT_LLM_DRY_RUN=0
# Zerodha Kite Connect. From https://developers.kite.trade (your app page).
KITE_API_KEY=
KITE_API_SECRET=
# Where raw and Parquet data files live.
SMT_LAKE_PATH=data/lake
# Where the feature store lives.
SMT_DB_PATH=data/smt.duckdb
